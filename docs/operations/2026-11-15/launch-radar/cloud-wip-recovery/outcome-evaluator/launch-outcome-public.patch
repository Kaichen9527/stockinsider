--- /dev/null
+++ b/web/src/lib/vnext/launch-outcome-public.ts
@@ -0,0 +1,102 @@
+import {evidenceInstant} from './evidence-clock.ts';
+import {LAUNCH_OUTCOME_HORIZONS,LAUNCH_OUTCOME_POLICY,LAUNCH_SIMULATION_COSTS} from './launch-outcomes.ts';
+
+const barriers=['up_first','down_first','order_unknown','price_data_gap','calendar_gap','pending','not_hit'] as const;
+const states=['ready','pending','price_data_gap','calendar_gap'] as const;
+const executionStatuses=['pending','opening_evidence_gap','unfillable','modeled_fill'] as const;
+const unfillableReasons=['suspended','one_price_upper_limit','no_executable_open'] as const;
+const windows=LAUNCH_OUTCOME_HORIZONS;
+const version='vnext-launch-outcome-public-v1';
+type Row=Record<string,unknown>;
+type Reference={rankingRunId:string;symbol:string;signalSession:string};
+type Barrier={state:typeof barriers[number];session:string|null};
+type Horizon={horizon:typeof windows[number];state:typeof states[number];terminalSession:string|null;grossReturnPct:number|null;netReturnPct:number|null};
+type Execution={status:typeof executionStatuses[number];nextSession:string|null;reason:typeof unfillableReasons[number]|null;
+  grossBarrier20:Barrier|null;netBarrier20:Barrier|null;horizons:Horizon[]};
+type Published=Reference&{schemaVersion:typeof version;policyVersion:typeof LAUNCH_OUTCOME_POLICY};
+export type PublicLaunchOutcome={state:'unavailable'}|
+  Published&{state:'not_started'|'awaiting_observation';firstRankingRunId:string|null;asOf:null;outcomeRevision:null;research:null;execution:null}|
+  Published&{state:'ready';firstRankingRunId:string;asOf:string;outcomeRevision:string;research:{barrier20:Barrier;horizons:Horizon[]};
+    execution:Execution;costs:typeof LAUNCH_SIMULATION_COSTS};
+
+function exact(value:unknown,keys:string):value is Row {
+  return !!value&&typeof value==='object'&&!Array.isArray(value)&&Object.keys(value).sort().join(' ')===keys.split(' ').sort().join(' ');
+}
+const uuid=(value:unknown):value is string=>typeof value==='string'&&/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/u.test(value);
+const sha=(value:unknown):value is string=>typeof value==='string'&&/^[0-9a-f]{64}$/u.test(value);
+const isDay=(v:unknown):v is string=>typeof v==='string'&&/^\d{4}-\d{2}-\d{2}$/u.test(v)&&evidenceInstant(v+'T00:00:00Z')!==null;
+const futureDay=(v:unknown,after:string):v is string|null=>v===null||(isDay(v)&&v>after);
+const enumValue=<T extends string>(v:unknown,values:readonly T[]):v is T=>typeof v==='string'&&(values as readonly string[]).includes(v);
+const finite=(v:unknown):v is number=>typeof v==='number'&&Number.isFinite(v);
+const rejected=()=>{throw Error('launch_outcome_public_projection_unavailable');};
+
+function barrier(value:unknown,signalSession:string):Barrier {
+  if(!exact(value,'state session')||!enumValue(value.state,barriers)||!futureDay(value.session,signalSession))return rejected();
+  const needsDate=!['pending','not_hit'].includes(value.state);
+  if(needsDate!==(value.session!==null))return rejected();
+  return {state:value.state,session:value.session};
+}
+
+function horizons(value:unknown,signalSession:string,includeNet:boolean):Horizon[]{
+  if(!Array.isArray(value)||value.length!==windows.length)return rejected();
+  return value.map((row,index)=>{
+    const horizon=windows[index];
+    if(!exact(row,'horizon state terminalSession grossReturnPct netReturnPct')||row.horizon!==horizon||
+      !enumValue(row.state,states)||!futureDay(row.terminalSession,signalSession))return rejected();
+    if(row.state==='ready'){
+      if(row.terminalSession===null||!finite(row.grossReturnPct)||(includeNet?!finite(row.netReturnPct):row.netReturnPct!==null))return rejected();
+    }else if(row.grossReturnPct!==null||row.netReturnPct!==null)return rejected();
+    return {horizon,state:row.state,terminalSession:row.terminalSession,
+      grossReturnPct:row.grossReturnPct as number|null,netReturnPct:row.netReturnPct as number|null};
+  });
+}
+
+function execution(value:unknown,signalSession:string):Execution{
+  if(!exact(value,'status nextSession reason grossBarrier20 netBarrier20 horizons')||
+    !enumValue(value.status,executionStatuses)||!futureDay(value.nextSession,signalSession))return rejected();
+  const {status,nextSession}=value;
+  if(status==='modeled_fill'){
+    if(nextSession===null||value.reason!==null)return rejected();
+    return {status,nextSession,reason:null,grossBarrier20:barrier(value.grossBarrier20,signalSession),
+      netBarrier20:barrier(value.netBarrier20,signalSession),horizons:horizons(value.horizons,signalSession,true)};
+  }
+  const reason=status==='unfillable'&&enumValue(value.reason,unfillableReasons)?value.reason:null;
+  if(value.reason!==reason||(status==='unfillable'&&(!reason||nextSession===null))||
+    value.grossBarrier20!==null||value.netBarrier20!==null||!Array.isArray(value.horizons)||value.horizons.length!==0)return rejected();
+  return {status,nextSession,reason,grossBarrier20:null,netBarrier20:null,horizons:[]};
+}
+
+export function parsePublicLaunchOutcome(value:unknown,ref:Reference):PublicLaunchOutcome {
+  if(!exact(value,'schemaVersion policyVersion rankingRunId symbol signalSession state firstRankingRunId asOf outcomeRevision research execution')||
+    value.schemaVersion!==version||value.policyVersion!==LAUNCH_OUTCOME_POLICY||
+    value.rankingRunId!==ref.rankingRunId||value.symbol!==ref.symbol||value.signalSession!==ref.signalSession)return rejected();
+  const published:Published={...ref,schemaVersion:version,policyVersion:LAUNCH_OUTCOME_POLICY};
+  if(value.state==='not_started'||value.state==='awaiting_observation'){
+    if((value.state==='not_started'?value.firstRankingRunId!==null:!uuid(value.firstRankingRunId))||
+      value.asOf!==null||value.outcomeRevision!==null||value.research!==null||value.execution!==null)return rejected();
+    return {...published,state:value.state,firstRankingRunId:value.firstRankingRunId as string|null,
+      asOf:null,outcomeRevision:null,research:null,execution:null};
+  }
+  if(value.state!=='ready'||!uuid(value.firstRankingRunId)||typeof value.asOf!=='string'||
+    evidenceInstant(value.asOf)===null||!sha(value.outcomeRevision)||!exact(value.research,'barrier20 horizons'))return rejected();
+  return {...published,state:'ready',firstRankingRunId:value.firstRankingRunId,asOf:value.asOf,outcomeRevision:value.outcomeRevision,
+    costs:LAUNCH_SIMULATION_COSTS,
+    research:{barrier20:barrier(value.research.barrier20,ref.signalSession),horizons:horizons(value.research.horizons,ref.signalSession,false)},
+    execution:execution(value.execution,ref.signalSession)};
+}
+
+type Reader={rpc:(name:string,args:{p_ranking_run_id:string;p_symbol:string})=>PromiseLike<{data:unknown;error:unknown}>};
+export async function readLaunchOutcomeProjection(reader:Reader,ref:Reference):Promise<PublicLaunchOutcome>{
+  if(!uuid(ref.rankingRunId)||!/^\d{4}$/u.test(ref.symbol)||!isDay(ref.signalSession))return {state:'unavailable'};
+  try{
+    const result=await reader.rpc('vnext_launch_outcome_public_v1',{p_ranking_run_id:ref.rankingRunId,p_symbol:ref.symbol});
+    return result.error||!result.data?{state:'unavailable'}:parsePublicLaunchOutcome(result.data,ref);
+  }catch{return {state:'unavailable'};}
+}
+
+export async function readPublicLaunchOutcome(ref:Reference):Promise<PublicLaunchOutcome>{
+  try{
+    const {getSupabaseServerClient}=await import('../supabase-server.ts');
+    return await readLaunchOutcomeProjection(getSupabaseServerClient(),ref);
+  }catch{return {state:'unavailable'};}
+}
diff --git a/web/src/app/components/vnext/LaunchOutcomeSummary.tsx b/web/src/app/components/vnext/LaunchOutcomeSummary.tsx
new file mode 100644
--- /dev/null
+++ b/web/src/app/components/vnext/LaunchOutcomeSummary.tsx
@@ -0,0 +1,69 @@
+import type {PublicLaunchOutcome} from '@/lib/vnext/launch-outcome-public';
+
+type Ready=Extract<PublicLaunchOutcome,{state:'ready'}>;
+type Horizon=Ready['research']['horizons'][number];
+type Barrier=Ready['research']['barrier20'];
+
+const timeFormat=new Intl.DateTimeFormat('zh-TW',{timeZone:'Asia/Taipei',dateStyle:'medium',timeStyle:'short',hourCycle:'h23'});
+const percentage=new Intl.NumberFormat('zh-TW',{style:'percent',maximumFractionDigits:2,signDisplay:'exceptZero'});
+const barrierLabels:Record<Barrier['state'],string>={
+  up_first:'先觸及 +20%',down_first:'先觸及 −15%',order_unknown:'同日觸及上下界，先後不明',
+  price_data_gap:'行情資料不足',calendar_gap:'交易日資料不足',pending:'尚未到期',not_hit:'20 個交易日內未觸及上下界',
+};
+const stateLabels:Record<Exclude<Horizon['state'],'ready'>,string>={pending:'尚未到期',price_data_gap:'行情資料不足',calendar_gap:'交易日資料不足'};
+const executionLabels:Record<Ready['execution']['status'],string>={pending:'等待下一個交易日',opening_evidence_gap:'開盤證據不足',
+  unfillable:'無法成交',modeled_fill:'依開盤價模擬成交'};
+const noFill:Record<NonNullable<Ready['execution']['reason']>,string>={suspended:'開盤時停牌',one_price_upper_limit:'一字鎖漲停',no_executable_open:'開盤無可成交價'};
+const pendingText:Record<Exclude<PublicLaunchOutcome['state'],'ready'>,string>={not_started:'這次上榜尚未納入成效追蹤。',
+  awaiting_observation:'等待下一個交易日的官方資料。',unavailable:'成效資料暫時無法讀取。'};
+
+function BarrierLabel({item}:{item:Barrier}){
+  return <>{barrierLabels[item.state]}{item.session&&<> · <time dateTime={item.session}>{item.session}</time></>}</>;
+}
+
+function MarkTable({rows,net}:{rows:Horizon[];net:boolean}){
+  return <table className="mt-3 w-full text-left text-sm">
+    <thead><tr className="border-b border-slate-300 dark:border-slate-700">
+      <th scope="col" className="pb-2">交易日</th>
+      <th scope="col" className="pb-2 text-right">{net?'成本前':'價格變動'}</th>
+      {net&&<th scope="col" className="pb-2 text-right">扣除成本</th>}
+    </tr></thead>
+    <tbody>{rows.map(row=><tr className={row.horizon===60?'border-b border-slate-200 font-semibold dark:border-slate-700':'border-b border-slate-200 dark:border-slate-700'} key={row.horizon}>
+      <th scope="row" className="py-2 font-medium">{row.horizon} 日{row.terminalSession&&<time dateTime={row.terminalSession} className="block text-xs font-normal text-slate-600 dark:text-slate-400">{row.terminalSession}</time>}</th>
+      {row.state==='ready'?<><td className="py-2 text-right tabular-nums">{row.grossReturnPct===null?'資料不足':percentage.format(row.grossReturnPct/100)}</td>
+        {net&&<td className="py-2 text-right tabular-nums">{row.netReturnPct===null?'資料不足':percentage.format(row.netReturnPct/100)}</td>}</>
+        :<td colSpan={net?2:1} className="py-2 text-right text-slate-600 dark:text-slate-400">{stateLabels[row.state]}</td>}
+    </tr>)}</tbody>
+  </table>;
+}
+
+export default function LaunchOutcomeSummary({outcome}:{outcome:PublicLaunchOutcome}){
+  return <section aria-labelledby="launch-outcome-heading" className="rounded-xl border border-slate-300 p-4 dark:border-slate-700">
+    <h2 id="launch-outcome-heading" className="font-semibold">上榜後成效</h2>
+    {outcome.state!=='ready'?<p className="mt-2 text-sm">{pendingText[outcome.state]}</p>:<>
+      <p className="mt-1 text-sm text-slate-600 dark:text-slate-400">
+        {outcome.firstRankingRunId===outcome.rankingRunId?'首次上榜':'連續上榜'} · 觀測至 <time dateTime={outcome.asOf}>{timeFormat.format(new Date(outcome.asOf))}</time>
+      </p>
+      <div className="mt-4 grid gap-5 sm:grid-cols-2">
+        <div>
+          <h3 className="font-semibold">發榜日收盤追蹤</h3>
+          <p className="mt-1 text-sm">20 日訊號　<BarrierLabel item={outcome.research.barrier20}/></p>
+          <MarkTable rows={outcome.research.horizons} net={false}/>
+        </div>
+        <div>
+          <h3 className="font-semibold">次一交易日開盤模擬</h3>
+          <p className="mt-1 text-sm">{executionLabels[outcome.execution.status]}{outcome.execution.reason&&<> · {noFill[outcome.execution.reason]}</>}
+            {outcome.execution.nextSession&&<> · <time dateTime={outcome.execution.nextSession}>{outcome.execution.nextSession}</time></>}</p>
+          {outcome.execution.grossBarrier20&&outcome.execution.netBarrier20&&<>
+            <p className="mt-1 text-sm">20 日訊號成本前　<BarrierLabel item={outcome.execution.grossBarrier20}/></p>
+            <p className="mt-1 text-sm">20 日訊號扣除成本　<BarrierLabel item={outcome.execution.netBarrier20}/></p>
+            <MarkTable rows={outcome.execution.horizons} net/>
+          </>}
+          <p className="mt-3 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
+            模擬成本為買賣各 {outcome.costs.buyCommissionPpm/10000}% 手續費、賣出稅 {outcome.costs.sellTaxPpm/10000}%，每邊滑價 {outcome.costs.slippagePerSidePpm/10000}%。
+          </p>
+        </div>
+      </div>
+    </>}
+  </section>;
+}
diff --git a/web/src/lib/vnext/launch-outcome-public.test.ts b/web/src/lib/vnext/launch-outcome-public.test.ts
new file mode 100644
--- /dev/null
+++ b/web/src/lib/vnext/launch-outcome-public.test.ts
@@ -0,0 +1,78 @@
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import test from 'node:test';
+import vm from 'node:vm';
+import ts from 'typescript';
+import {parsePublicLaunchOutcome,readLaunchOutcomeProjection,type PublicLaunchOutcome} from './launch-outcome-public.ts';
+
+const ref={rankingRunId:'00000000-0000-4000-8000-000000000003',symbol:'1234',signalSession:'2026-10-05'};
+const first='00000000-0000-4000-8000-000000000001';
+const base={...ref,schemaVersion:'vnext-launch-outcome-public-v1',policyVersion:'launch-outcomes-v1',firstRankingRunId:first,
+  state:'ready',asOf:'2026-11-05T13:30:00+00:00',outcomeRevision:'a'.repeat(64)};
+const period={horizon:20,state:'ready',terminalSession:'2026-11-02',grossReturnPct:0,netReturnPct:null};
+const waiting={horizon:60,state:'pending',terminalSession:null,grossReturnPct:null,netReturnPct:null};
+const gap={horizon:120,state:'calendar_gap',terminalSession:null,grossReturnPct:null,netReturnPct:null};
+const barrier={state:'order_unknown',session:'2026-10-12'};
+const completed={...base,research:{barrier20:barrier,horizons:[period,waiting,gap]},
+  execution:{status:'modeled_fill',nextSession:'2026-10-06',reason:null,grossBarrier20:barrier,
+    netBarrier20:{state:'down_first',session:'2026-10-09'},horizons:[{...period,grossReturnPct:20,netReturnPct:19.25},waiting,gap]}};
+
+test('performance projection binds the frozen run, stock, and session and rejects nested private keys',()=>{
+  const projected=parsePublicLaunchOutcome(completed,ref);
+  assert.equal(projected.state,'ready');
+  if(projected.state==='ready'){
+    assert.equal(projected.research.horizons[0].grossReturnPct,0);
+    assert.equal(projected.execution.horizons[0].netReturnPct,19.25);
+    assert.equal(projected.costs.sellTaxPpm,3000);
+  }
+  for(const payload of [{...completed,symbol:'5678'},{...completed,signalSession:'2026-10-06'},
+    {...completed,research:{...completed.research,privateBody:'SYNTHETIC_PRIVATE_BLOCK'}},
+    {...completed,research:{...completed.research,horizons:[{...period,netReturnPct:2},waiting,gap]}},
+    {...completed,execution:{...completed.execution,horizons:[waiting,period,gap]}}]){
+    assert.throws(()=>parsePublicLaunchOutcome(payload,ref),/launch_outcome_public_projection_unavailable/);
+  }
+});
+
+test('performance reader calls only the readonly RPC, sanitizes errors, and skips invalid IDs',async()=>{
+  const calls:unknown[]=[];
+  const expect={state:'unavailable'};
+  const reader={async rpc(name:string,args:unknown){calls.push([name,args]);return {data:{private:'SECRET'},error:'SECRET'};}};
+  assert.deepEqual(await readLaunchOutcomeProjection(reader,{...ref,rankingRunId:'bad'}),expect);
+  assert.deepEqual(calls,[]);
+  assert.deepEqual(await readLaunchOutcomeProjection(reader,ref),expect);
+  assert.deepEqual(calls,[['vnext_launch_outcome_public_v1',{p_ranking_run_id:ref.rankingRunId,p_symbol:ref.symbol}]]);
+});
+
+const require=createRequire(import.meta.url);
+const {createElement}=require('react') as typeof import('react');
+const {renderToStaticMarkup}=require('react-dom/server') as typeof import('react-dom/server');
+function render(outcome:PublicLaunchOutcome){
+  const file=new URL('../../app/components/vnext/LaunchOutcomeSummary.tsx',import.meta.url);
+  const compiled=ts.transpileModule(readFileSync(file,'utf8'),{fileName:file.pathname,compilerOptions:{
+    target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.CommonJS,jsx:ts.JsxEmit.ReactJSX}}).outputText;
+  const isolated={exports:{} as {default?:import('react').ComponentType<{outcome:PublicLaunchOutcome}>}};
+  vm.runInNewContext(compiled,{require,module:isolated,exports:isolated.exports,Date,Intl});
+  assert.ok(isolated.exports.default);
+  return renderToStaticMarkup(createElement(isolated.exports.default,{outcome}));
+}
+
+test('actual outcome panel separates research from simulated returns and labels uncertainty and costs',()=>{
+  const markup=render(parsePublicLaunchOutcome(completed,ref));
+  for(const value of ['發榜日收盤追蹤','次一交易日開盤模擬','連續上榜','觀測至','0%','+19.25%','尚未到期','交易日資料不足',
+    '同日觸及上下界，先後不明','60 日','0.1425','0.3','0.1'])assert.ok(markup.includes(value),value);
+  assert.match(markup,/<table/u);
+  assert.doesNotMatch(markup,/snapshotHash|rankingRunId|SYNTHETIC_PRIVATE_BLOCK/u);
+});
+
+test('actual outcome panel renders unfillable, older rankings, and unavailable observations independently',()=>{
+  const unfillable=parsePublicLaunchOutcome({...completed,execution:{status:'unfillable',nextSession:'2026-10-06',
+    reason:'suspended',grossBarrier20:null,netBarrier20:null,horizons:[]}},ref);
+  const markup=render(unfillable);
+  assert.match(markup,/無法成交.*開盤時停牌/u);
+  assert.doesNotMatch(markup,/<th[^>]*>扣除成本/u);
+  const empty={...base,asOf:null,outcomeRevision:null,research:null,execution:null};
+  assert.match(render(parsePublicLaunchOutcome({...empty,state:'not_started',firstRankingRunId:null},ref)),/尚未納入成效追蹤/u);
+  assert.match(render(parsePublicLaunchOutcome({...empty,state:'awaiting_observation'},ref)),/等待下一個交易日/u);
+  assert.match(render({state:'unavailable'}),/暫時無法讀取/u);
+});
