[Unit]
Description=StockInsider Taiwan close preliminary dataset refresh
After=network-online.target stockinsider-web-standalone.service
Wants=network-online.target
Requires=stockinsider-web-standalone.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/stockinsider/current
EnvironmentFile=/etc/stockinsider/stockinsider.env
Environment=APP_URL=http://127.0.0.1:3100
Environment=EXPECTED_APP_URL=http://127.0.0.1:3100
ExecStart=/usr/bin/flock -w 900 /run/lock/stockinsider-production-write.lock /usr/bin/env APP_URL=http://127.0.0.1:3100 EXPECTED_APP_URL=http://127.0.0.1:3100 /usr/bin/node scripts/call_internal_api_sequence.mjs '[{"endpoint":"/api/internal/taiwan-data-refresh","payload":{"datasets":["daily_price","daily_valuation","monthly_revenue","market_index","institutional_flow","margin_short"],"phase":"preliminary","symbols":[]},"timeoutMs":120000},{"endpoint":"/api/internal/taiwan-data-queue-drain","payload":{"limit":100,"maxBatches":30,"requireComplete":true,"phase":"preliminary"},"timeoutMs":2700000}]'
TimeoutStartSec=3900
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
