[Unit]
Description=StockInsider credential-free financial document parser
Requires=stockinsider-financial-parser.socket
After=stockinsider-financial-parser.socket

[Service]
Type=simple
DynamicUser=true
ExecStart=/opt/stockinsider/runtime/candidate-financial-parser/bin/python /opt/stockinsider/runtime/candidate-financial-parser/app/candidate_financial_parser_socket.py
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1G
TasksMax=32
UMask=0077
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONHASHSEED=0
Environment=NO_PROXY=*
Environment=no_proxy=*
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1

[Install]
WantedBy=multi-user.target
