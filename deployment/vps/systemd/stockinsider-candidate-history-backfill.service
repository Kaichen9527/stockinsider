[Unit]
Description=Backfill bounded StockInsider candidate price and valuation history
After=network-online.target stockinsider-internal-worker.service stockinsider-capacity-watch.service
Wants=network-online.target
Requires=stockinsider-internal-worker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/stockinsider/current
EnvironmentFile=/etc/stockinsider/stockinsider.env
Environment=APP_URL=http://127.0.0.1:3101
Environment=EXPECTED_APP_URL=http://127.0.0.1:3101
ExecStartPre=/usr/bin/node scripts/contabo-host-resource-check.mjs /opt/stockinsider/current/deployment/vps/capacity-watch-budget.json
ExecStart=/usr/bin/flock -w 900 /run/lock/stockinsider-production-write.lock /usr/bin/env APP_URL=http://127.0.0.1:3101 EXPECTED_APP_URL=http://127.0.0.1:3101 INTERNAL_API_TIMEOUT_MS=2700000 /usr/bin/node scripts/call_internal_api.mjs /api/internal/candidate-history-backfill '{"requestBudget":80,"perStockBudget":4}'
TimeoutStartSec=2750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
