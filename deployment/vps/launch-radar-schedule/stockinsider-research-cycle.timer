[Unit]
Description=Run StockInsider launch radar background, research and publication on the Taipei schedule

[Timer]
OnCalendar=*-*-* 08:15:00 Asia/Taipei
OnCalendar=*-*-* 20:55:00 Asia/Taipei
OnCalendar=*-*-* 21:30:00 Asia/Taipei
Persistent=true
AccuracySec=1s
Unit=stockinsider-research-cycle.service

[Install]
WantedBy=timers.target
