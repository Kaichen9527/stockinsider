[Unit]
Description=StockInsider launch radar preliminary data preparation
After=network-online.target stockinsider-internal-worker.service
Wants=network-online.target
Requires=stockinsider-internal-worker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/stockinsider/current
EnvironmentFile=/etc/stockinsider/stockinsider.env
Environment=APP_URL=http://127.0.0.1:3101
Environment=EXPECTED_APP_URL=http://127.0.0.1:3101
ExecStart=/usr/bin/flock -w 1800 /run/lock/stockinsider-production-write.lock /usr/bin/node scripts/run-launch-scheduled-cycle.mjs preliminary
TimeoutStartSec=8400
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
