      "oldFragment": " ELSIF p_command='exit' THEN\n",
      "newFragment": " ELSIF p_command='exit' THEN\n  IF r->>'reason'='target_hit' THEN\n   IF jsonb_typeof(r->'targetProof') IS DISTINCT FROM 'object' OR jsonb_typeof(r->'targetProof'->'revisionId') IS DISTINCT FROM 'string' OR coalesce(r->'targetProof'->>'revisionId','') !~ '^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$' OR jsonb_typeof(r->'targetProof'->'inputHash') IS DISTINCT FROM 'string' OR coalesce(r->'targetProof'->>'inputHash','') !~ '^[a-f0-9]{64}$' THEN RAISE EXCEPTION 'vnext_target_current_authority_required'; END IF;\n   IF public.vnext_target_current_v1(r->>'symbol',(r->'targetProof'->>'revisionId')::uuid,r->'targetProof'->>'inputHash') IS DISTINCT FROM r->'targetProof' OR NOT(r->'targetProof' ? 'proofHash') OR r->'evidence' IS DISTINCT FROM jsonb_build_array(r->'targetProof'->>'proofHash') THEN RAISE EXCEPTION 'vnext_target_current_authority_required'; END IF;\n  END IF;\n"
    }
