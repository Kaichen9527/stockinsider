      ],
      [
        "c",
        "CHECK (status <> 'successful_empty'::text OR response_kind = 'http_response'::text AND response_status_code >= 200 AND response_status_code <= 299 AND item_count = 0 AND document_count = 0)"
      ],
      [
        "c",
