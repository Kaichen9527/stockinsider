    "legacy_source_connector_attempts_v3_13": [
      [
        "c",
        "CHECK (\nCASE status\n    WHEN 'items_found'::text THEN reason_code ~ '_items_observed$'::text\n    WHEN 'successful_empty'::text THEN reason_code ~ '_successful_empty$'::text\n    WHEN 'metadata_only'::text THEN reason_code ~ '(_metadata_only|_authority_missing)$'::text\n    WHEN 'missing_endpoint'::text THEN reason_code ~ '(_missing|_not_found)$'::text\n    WHEN 'auth_failed'::text THEN reason_code ~ '(_auth_missing|_oauth_missing|^provider_auth_rejected$)'::text\n    WHEN 'provider_failed'::text THEN reason_code = 'provider_transport_failed'::text\n    ELSE false\nEND)"
      ],
      [
        "c",
        "CHECK ((response_kind = 'http_response'::text) = (response_status_code IS NOT NULL))"
      ],
      [
        "c",
        "CHECK (document_count >= 0 AND document_count <= 10)"
      ],
      [
        "c",
        "CHECK (item_count >= 0 AND item_count <= 20)"
      ],
      [
        "c",
        "CHECK (reason_code ~ '^[a-z0-9_]{2,80}$'::text)"
      ],
      [
        "c",
        "CHECK (response_bytes >= 0 AND response_bytes <= 8000000)"
      ],
      [
        "c",
        "CHECK (response_kind = ANY (ARRAY['http_response'::text, 'configuration'::text, 'transport_error'::text]))"
      ],
      [
        "c",
        "CHECK (response_status_code >= 100 AND response_status_code <= 599)"
      ],
      [
        "c",
        "CHECK (source_key = ANY (ARRAY['threads'::source_key_v3, 'podcast'::source_key_v3, 'youtube'::source_key_v3]))"
      ],
      [
        "c",
        "CHECK (status <> 'auth_failed'::text OR response_kind = 'configuration'::text AND response_status_code IS NULL OR response_kind = 'http_response'::text AND (response_status_code = ANY (ARRAY[401, 403])))"
      ],
      [
        "c",
        "CHECK (status <> 'items_found'::text OR response_kind = 'http_response'::text AND response_status_code >= 200 AND response_status_code <= 299 AND (item_count > 0 OR document_count > 0))"
      ],
      [
        "c",
        "CHECK (status <> 'metadata_only'::text OR response_kind = 'http_response'::text AND response_status_code >= 200 AND response_status_code <= 299 AND item_count > 0 AND document_count = 0)"
      ],
      [
        "c",
        "CHECK (status <> 'missing_endpoint'::text OR response_kind = 'configuration'::text AND response_status_code IS NULL OR response_kind = 'http_response'::text AND response_status_code = 404)"
