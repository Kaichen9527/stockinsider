sessionid=
csrftoken=
ds_user_id=
ig_did=
mid=
datr=
ps_l=
ps_n=

# InvestAnchors account (for Playwright login)
INVESTANCHORS_ACCOUNT=
INVESTANCHORS_PASSWORD=
Account=
Password=

# Telegram Bot Token (for Bot API; public channels also work via t.me/s/ HTML scrape)
