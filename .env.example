# ===== Required (blocking) =====

# Shared
APP_ENV=development
# Data source mode: `live` (default, no implicit demo fallback) or `demo`
DATA_MODE=live
# Legacy toggle (kept for backward compatibility)
STOCKINSIDER_FORCE_DEMO=false

# Supabase
SUPABASE_URL=https://mgqpxfbdhmiygdytgswi.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://mgqpxfbdhmiygdytgswi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase DB (for apply_schema.js)
SUPABASE_PROJECT_REF=mgqpxfbdhmiygdytgswi
SUPABASE_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
SUPABASE_DB_USER=postgres.mgqpxfbdhmiygdytgswi
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_DATABASE=postgres

# LINE
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN

# Freshness gate
SIGNAL_FRESHNESS_THRESHOLD_SECONDS=3600

# Internal API / Scheduler
INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY
CRON_SECRET=YOUR_CRON_SECRET
PORT=3010
BASE_URL=http://127.0.0.1:3010
PIPELINE_INPROCESS_RETRY=false
PIPELINE_SYNC_TIMEOUT_MS=18000
RECOMMENDATION_BATCH_TIMEOUT_MS=15000
STORY_CANDIDATE_TOP_N=50
SOURCE_SYNC_LOOKBACK_HOURS=24

# Source governance thresholds
SOURCE_MIN_CONFIDENCE=0.45
SOURCE_MIN_PARSE_SUCCESS_RATIO=0.6
SOURCE_REQUEST_TIMEOUT_SECONDS=8

# Monitoring thresholds
BLOCKED_RECOMMENDATION_ALERT_RATIO=0.35

# Alerting
ALERT_WEBHOOK_URL=YOUR_ALERT_WEBHOOK_URL

# ===== Source-led Opportunity V3 (shadow only; disabled by default) =====
# Allowed values: disabled | drain | shadow
SOURCE_LED_OPPORTUNITY_V3=disabled
# Independent additive legacy-radar correctness read model. Keep disabled until a
# reviewed tracked producer has published all four fresh projection windows.
LEGACY_RADAR_CORRECTNESS_PROJECTION=disabled
# Required only when SOURCE_LED_OPPORTUNITY_V3=shadow.
OPPORTUNITY_V3_SUPABASE_PROJECT_REF=
OPPORTUNITY_V3_SERVICE_ROLE_KEY_SHA256=
# Optional operator diagnostic inputs for `npm run v3:status`.
OPPORTUNITY_V3_APP_URL=http://127.0.0.1:3000
OPPORTUNITY_V3_RUN_ID=

# ===== Optional (non-blocking) =====

# Optional Integrations
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
PREFECT_API_URL=http://localhost:4200/api

# Optional smoke test controls
OPSX_MUTATING_SMOKE=false

# ===== Social / Connector credentials =====

# Threads dedicated login + persisted session
THREADS_USERNAME=
THREADS_PASSWORD=
THREADS_SESSION_STATE=

# Optional emergency fallback cookies for Threads only
THREADS_COOKIE_FALLBACK_SESSIONID=
THREADS_COOKIE_FALLBACK_CSRFTOKEN=
THREADS_COOKIE_FALLBACK_DS_USER_ID=
THREADS_COOKIE_FALLBACK_IG_DID=
THREADS_COOKIE_FALLBACK_MID=
THREADS_COOKIE_FALLBACK_DATR=
THREADS_COOKIE_FALLBACK_PS_L=
THREADS_COOKIE_FALLBACK_PS_N=

# Optional Instagram dedicated login + persisted session
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_STATE=

# Optional emergency fallback cookies for Instagram only
INSTAGRAM_COOKIE_FALLBACK_SESSIONID=
INSTAGRAM_COOKIE_FALLBACK_CSRFTOKEN=
INSTAGRAM_COOKIE_FALLBACK_DS_USER_ID=
INSTAGRAM_COOKIE_FALLBACK_IG_DID=
INSTAGRAM_COOKIE_FALLBACK_MID=
INSTAGRAM_COOKIE_FALLBACK_DATR=
INSTAGRAM_COOKIE_FALLBACK_PS_L=
INSTAGRAM_COOKIE_FALLBACK_PS_N=

