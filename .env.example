# Optional: YouTube Data API v3 key (for podcast episode listing via API)
YOUTUBE_API_KEY=

# Auth source worker
SOURCE_WORKER_SYMBOLS=2454,2379,2337
THREADS_STOCK_REFRESH_INTERVAL_MINUTES=45
INVESTANCHORS_STOCK_REFRESH_INTERVAL_MINUTES=180
KOL_CONTENT_REFRESH_INTERVAL_MINUTES=240
INDUSTRY_DISCOVERY_REFRESH_INTERVAL_MINUTES=240
FULL_RESEARCH_REBUILD_INTERVAL_MINUTES=720
AUTH_SOURCE_WORKER_POLL_SECONDS=60

# OpenAI API key (for Whisper audio transcription fallback when YouTube captions unavailable)
OPENAI_API_KEY=

# ===== GitHub Actions secrets (set in repo Settings → Secrets → Actions) =====
# APP_URL=https://your-vercel-production-url.vercel.app
# INTERNAL_API_KEY=same value as above
# Source authorization gates. Production collectors remain visibly blocked until
# the corresponding rights or official API credential has been confirmed.
THREADS_ACCESS_TOKEN=
TELEGRAM_PUBLIC_CHANNELS_AUTHORIZED=false
TELEGRAM_BOT_GROUPS_AUTHORIZED=false
PTT_METADATA_AUTHORIZED=false
BULLTALK_LICENSED=false
BULLTALK_AUTHORIZED_FEED_URL=
BULLTALK_AUTHORIZED_FEED_TOKEN=
