'::text, 'action_range'::text])))"], ["entry_plan_authority_jobs_v1_missing_rows_check", "CHECK ((missing_rows >= 0))"], ["entry_plan_authority_jobs_v1_month_check", "CHECK (((month IS NULL) OR (month ~ '^[0-9]{4}-(0[1-9]|1[0-2])$'::text)))"], ["entry_plan_authority_jobs_v1_pkey", "PRIMARY KEY (run_id, job_key)"], ["entry_plan_authority_jobs_v1_run_id_fkey", "FOREIGN KEY (run_id) REFERENCES entry_plan_authority_runs_v1(run_id) ON DELETE RESTRICT"], ["entry_plan_authority_jobs_v1_sessions_check", "CHECK ((jsonb_typeof(sessions) = 'array'::text))"], ["entry_plan_authority_jobs_v1_source_urls_check", "CHECK ((jsonb_typeof(source_urls) = 'array'::text))"], ["entry_plan_authority_jobs_v1_status_check", "CHECK ((status = ANY (ARRAY['pending'::text, 'running'::text, 'retry'::text, 'complete'::text, 'failed'::text])))"], ["entry_plan_authority_jobs_v1_symbol_check", "CHECK (((symbol IS NULL) OR (symbol ~ '^[0-9]{4}$'::text)))"]]}
