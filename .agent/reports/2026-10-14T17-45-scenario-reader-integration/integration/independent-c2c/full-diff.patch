+  const cash=projectPinnedHistoricalCash(profile,symbol,owned,deadline);deadline.check();ensure(financialInstant(cash.extractionAvailableAt)<=financialInstant(readAt));
+  const projection={...project(symbol,records,readAt),historicalCash:cash};deadline.check();
+  assertFinancialJsonBytes(projection,historicalCashPins.limits.projection);
+  const calculation=recalculateResearchBusinessScenarios(projection.projected,readAt);deadline.check();
+  const result={schemaVersion:'research-scenario-cash-material-candidate-v3',financialProfile:profile,symbol,status:'unsealed_calculation_only',artifactReadKnownAt:readAt,
