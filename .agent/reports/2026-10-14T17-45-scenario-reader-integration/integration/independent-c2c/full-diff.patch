+  const envelope=row(JSON.parse(new TextDecoder('utf8',{fatal:true}).decode(owned)));deadline.check();
+  ensure(envelope.schemaVersion==='historical-cash-private-byte-material-v1'&&envelope.financialProfile===profile&&envelope.symbol===symbol);
+  const entries=list(envelope.files,9);ensure(entries.length===selected.files.length);let total=0;
+  for(let i=0;i<selected.files.length;i++){
