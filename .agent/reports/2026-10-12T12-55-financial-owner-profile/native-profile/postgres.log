	    REVOKE EXECUTE ON FUNCTION
	      public.enrich_legacy_retained_candidate_authority_v3_19_11_internal(uuid,jsonb)
	      FROM stockinsider_runtime_v319;
	    REVOKE EXECUTE ON FUNCTION
	      public.read_legacy_prior_candidate_result_v3_19_12_internal(uuid)
